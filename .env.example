# Transformer-Based NIDS & CTI Platform Configuration
# Copy this file to .env and adjust variables as needed

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Transformer-Based NIDS & Cyber Threat Intelligence Platform"

# Security (Change in production!)
SECRET_KEY=dev-secret-key-change-in-production-cyber-sentinel-2026
DEV_MODE_AUTH=True

# Database Persistence
# Development default uses local SQLite:
DATABASE_URL=sqlite:///./data/nids_platform.db
# To connect to your actual PostgreSQL instance, uncomment and configure:
# DATABASE_URL=postgresql+psycopg2://cyber_admin:YourSecurePassword@localhost:5432/nids_enterprise_db

# BigFlow-NIDS Dataset Configuration
# Parquet files are preferred over CSV for memory efficiency
PRIMARY_DATASET_TYPE=BigFlow-NIDS-V2
BIGFLOW_NIDS_PARQUET_DIR=./BigFlow-NIDS/BigFlow-NIDS-V2-Merged-Parquet
BIGFLOW_NIDS_CSV_PATH=./BigFlow-NIDS/BigFlow-NIDS-CSV/BigFlow-NIDS-V2.csv
DEFAULT_TRAIN_SAMPLE_SIZE=10000

# Optional External CTI API Keys (Optional - leaves platform fully functional in simulated/offline mode)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Optional LLM Explainability Provider (Optional - rule & evidence explainability works offline)
LLM_PROVIDER=simulation
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
